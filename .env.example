SPRING_PROFILES_ACTIVE=local
NEXT_PUBLIC_API_URL=http://localhost:8080

OCR_WORKER_URL=http://ocr-worker:8000
X_INTERNAL_KEY=dev-internal-key
ENABLE_FALLBACK_OCR=false
OCR_CONFIDENCE_WARN_THRESHOLD=0.70

OCR_ENGINE=paddle
ENABLE_VISION_OCR=false
GOOGLE_APPLICATION_CREDENTIALS_PATH=C:\path\to\service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-vision-key.json
